# Public NEAR testnet configuration
NEXT_PUBLIC_NETWORK_ID=testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_FACTORY_ID=auspice-yagnesh.testnet
NEXT_PUBLIC_COIN_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only. Do not expose these as NEXT_PUBLIC_* values.
# Optional public launch defaults used by the create form.
# NEXT_PUBLIC_HUMAN_PASS_PUBLIC_KEY=
# NEXT_PUBLIC_VERIFIER_WASM_URL=
# NEXT_PUBLIC_VERIFIER_WASM_HASH=
# NEXT_PUBLIC_DEMO_GITHUB_REPOSITORY=juSt-jeLLy/Auspice
# NEXT_PUBLIC_DEMO_REQUIRED_TAG=v1.0.0
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_HUMAN_VERIFIER_WASM_URL=
# NEXT_PUBLIC_HUMAN_VERIFIER_WASM_HASH=
# NEXT_PUBLIC_HUMAN_VERIFIER_PROJECT_ID=

# Local testnet convenience: point to a private PEM file with owner-only permissions.
# HUMAN_PASS_SIGNING_KEY_PEM_FILE=/absolute/path/to/human-pass.pem
# TESTNET_DEMO_MODE=false
# HUMAN_PASS_CHALLENGE_SECRET=
# HUMAN_PASS_SIGNING_KEY_PEM=
# HUMAN_PASS_MAX_ALLOCATION=1000
# OUTLAYER_API_KEY=
